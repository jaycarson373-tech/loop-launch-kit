# Add these to Vercel Project Settings > Environment Variables.
# Use a separate database and separate secrets for Preview deployments.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Generate two DIFFERENT values with: openssl rand -hex 32
LOOP_ADMIN_PASSWORD=
LOOP_SESSION_SECRET=
# Execution stays off until signer, RPC, treasury, keeper and acceptance are ready.
LOOP_EXECUTION_ENABLED=false
LOOP_CLUSTER=devnet
