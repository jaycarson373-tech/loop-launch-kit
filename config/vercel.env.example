# Add these to Vercel Project Settings > Environment Variables.
# Use a separate database and separate secrets for Preview deployments.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Generate a session secret with: openssl rand -hex 32
LOOP_SESSION_SECRET=
# Optional operator-only password; use a DIFFERENT generated value.
# Users sign in with their own Solana wallets.
LOOP_ADMIN_PASSWORD=
# Execution stays off until signer, RPC, treasury, keeper and acceptance are ready.
LOOP_EXECUTION_ENABLED=false
LOOP_CLUSTER=devnet
